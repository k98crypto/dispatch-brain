# Copy to .env and fill in ONLY the providers you actually use.
# Keys live in environment variables, never in YAML config files.

# DeepSeek (China-direct)
DEEPSEEK_API_KEY=

# Alibaba DashScope / Qwen-VL (China-direct)
DASHSCOPE_API_KEY=

# Optional: your own local / self-hosted OpenAI-compatible endpoint
# (e.g. Ollama on a home server). Leave empty to use the default in models.yaml.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# Optional: protect the gateway itself with a bearer key.
DISPATCH_BRAIN_API_KEY=

# Optional: where the SQLite task log lives (default: ./data/task_log.db)
DISPATCH_BRAIN_DB=
